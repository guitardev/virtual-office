# ==============================================================
# Smart MSO - Vercel & Supabase Marketplace Integration Config
# ==============================================================
# เมื่อเชื่อมต่อผ่าน Vercel Marketplace (Integrations > Supabase)
# Vercel จะตั้งค่า Environment Variables เหล่านี้ให้อัตโนมัติ:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Database connection pool (provided by Vercel Integration)
# POSTGRES_URL=postgres://...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==============================================================
# Cloudflare Integration Suite Config
# ==============================================================
# 1. Cloudflare Turnstile (Bot Protection for Login / Request Form)
# Default test keys for development (always passes):
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 2. Cloudflare Tunnel Domain for Synology NAS (When connecting via Tunnel)
NEXT_PUBLIC_SYNOLOGY_NAS_URL=https://nas.smso.site
# Optional Local LAN URL (for office intranet fallback)
NEXT_PUBLIC_SYNOLOGY_LAN_URL=http://192.168.162.26:5000

# ==============================================================
# Synology DSM Service Account (Background Server Operations)
# ==============================================================
SYNOLOGY_SERVICE_ACCOUNT=your_service_account_username
SYNOLOGY_SERVICE_PASSWORD=your_service_account_password

# ==============================================================
# Synology NAS MariaDB 10 & Attendance Fingerprint Terminal
# ==============================================================
NAS_MYSQL_HOST=192.168.162.23
NAS_MYSQL_PORT=3308
NAS_MYSQL_USER=smartmso
NAS_MYSQL_PASSWORD=your_nas_mariadb_password
NAS_MYSQL_DATABASE=smart_mso_attendance
NAS_MYSQL_BRIDGE_URL=https://db.smso.site/attendance-bridge.php
NAS_MYSQL_BRIDGE_SECRET=your_bridge_secret_token

# HIP CMi681S Fingerprint Scanner (TCP/IP CIF12_1 Protocol)
HIP_SCANNER_IP=192.168.162.15
HIP_SCANNER_PORT=5005
HIP_SCANNER_PASSWORD=1234
