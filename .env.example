# ==============================================================
# Smart MSO - Vercel & Supabase Marketplace Integration Config
# ==============================================================
# เมื่อเชื่อมต่อผ่าน Vercel Marketplace (Integrations > Supabase)
# Vercel จะตั้งค่า Environment Variables เหล่านี้ให้อัตโนมัติ:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Database connection pool (provided by Vercel Integration)
# POSTGRES_URL=postgres://...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==============================================================
# Cloudflare Integration Suite Config
# ==============================================================
# 1. Cloudflare Turnstile (Bot Protection for Login / Request Form)
# Default test keys for development (always passes):
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 2. Cloudflare Tunnel Domain for Synology NAS (When connecting via Tunnel)
NEXT_PUBLIC_SYNOLOGY_NAS_URL=https://nas.smso.site

