# ==============================================================
# OmniOffice - Vercel & Supabase Marketplace Integration Config
# ==============================================================
# เมื่อเชื่อมต่อผ่าน Vercel Marketplace (Integrations > Supabase)
# Vercel จะตั้งค่า Environment Variables เหล่านี้ให้อัตโนมัติ:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Database connection pool (provided by Vercel Integration)
# POSTGRES_URL=postgres://...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
